# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control. NEVER paste these values into chat with Claude or anyone else.
#
# Any platform left blank runs in DEMO mode: "Connect" succeeds instantly and
# broadcasts are simulated, so you can use the full app before API access is approved.

# Where the Signal dashboard frontend is hosted, for CORS + redirect purposes
FRONTEND_URL=http://localhost:5173

# A long random string used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# --- Meta (Instagram + Facebook) ---
# From developers.facebook.com -> Your App -> Settings -> Basic
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/meta/callback

# --- Google (Google Business Profile) ---
# From console.cloud.google.com -> APIs & Services -> Credentials -> OAuth Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- TikTok (Content Posting API) ---
# TikTok requires app review before you get production posting access.
# From developers.tiktok.com -> Manage apps -> your app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback
